# 复制为 .env 后再填写。不要把 .env 提交进仓库。
OPENAI_API_KEY=sk-your-key-here

# 官方 OpenAI 可留空；国内兼容网关填写其地址，例如：
# DeepSeek: https://api.deepseek.com
# OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=

# DeepSeek 官方模型名：deepseek-v4-flash 或 deepseek-v4-pro
OPENAI_MODEL=deepseek-v4-flash

# 界面下拉可选模型（逗号分隔）。不填则按网关给一组常用名
# OPENAI_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-chat

# 单次任务最多循环多少轮（防止无限调工具）
AGENT_MAX_STEPS=20

# 本地命令超时（秒）
AGENT_CMD_TIMEOUT=60

# 模型请求超时（秒）。V4 默认思考模式会很慢，超时后界面才不会一直转圈
# AGENT_LLM_TIMEOUT=90

# 模型调用失败后再试几次（超时 / 连不上 / 429）。流式已有输出时不再自动重试
# AGENT_LLM_MAX_RETRIES=2
# AGENT_LLM_RETRY_BASE=0.6

# DeepSeek V4：disabled 关闭思考（agent 更快）；enabled 打开思考
# AGENT_LLM_THINKING=disabled
